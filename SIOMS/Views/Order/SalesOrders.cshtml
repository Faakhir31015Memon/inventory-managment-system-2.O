@model IEnumerable<SIOMS.Models.SalesOrder>
@{
    ViewData["Title"] = "Sales Orders";
    ViewData["Subtitle"] = "Manage customer sales orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header">
                <h2>Sales Orders</h2>
                <p class="text-muted">Manage customer sales orders</p>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form method="get" asp-controller="Order" asp-action="SalesOrders" id="salesFilterForm"
                          class="row g-2 align-items-center">
                        <!-- Status -->
                        <div class="col-auto">
                            <select name="status" class="form-select" style="min-width:130px;">
                                <option value="">All Status</option>
                                <option value="Processing" selected="@(ViewBag.StatusFilter == "Processing")">Processing
                                </option>
                                <option value="Completed" selected="@(ViewBag.StatusFilter == "Completed")">Completed
                                </option>
                                <option value="Cancelled" selected="@(ViewBag.StatusFilter == "Cancelled")">Cancelled
                                </option>
                            </select>
                        </div>
                        <!-- From Date -->
                        <div class="col-auto">
                            <div class="input-group" style="min-width:180px;">
                                <span class="input-group-text">From</span>
                                <input type="date" name="fromDate" id="salesFromDate" class="form-control"
                                       value="@ViewBag.FromDate">
                            </div>
                        </div>
                        <!-- To Date -->
                        <div class="col-auto">
                            <div class="input-group" style="min-width:180px;">
                                <span class="input-group-text">To</span>
                                <input type="date" name="toDate" id="salesToDate" class="form-control"
                                       value="@ViewBag.ToDate">
                            </div>
                        </div>
                        <!-- Search Button -->
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Search
                            </button>
                        </div>
                        <!-- Reset Button -->
                        @if (!string.IsNullOrEmpty(ViewBag.StatusFilter) || !string.IsNullOrEmpty(ViewBag.FromDate) ||
                        !string.IsNullOrEmpty(ViewBag.ToDate))
                        {
                            <div class="col-auto">
                                <a asp-controller="Order" asp-action="SalesOrders" class="btn btn-secondary">
                                    <i class="fas fa-redo"></i> Reset
                                </a>
                            </div>
                        }
                        <!-- New Sales Order Button - Aligned right -->
                        <div class="col ms-auto text-end">
                            <a asp-controller="Order" asp-action="CreateSalesOrder" class="btn btn-success">
                                <i class="fas fa-plus"></i> New Sales Order
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card animate-slide-up">
                <div class="card-body">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Customer</th>
                                    <th>Supplier</th>
                                    <th>Order Date</th>
                                    <th>Items</th>
                                    <th>Total Amount</th>
                                    <th>Paid</th>
                                    <th>Due</th>
                                    <th>Status</th>
                                    <th>Payment</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Any())
                                {
                                    @foreach (var order in Model)
                                    {
                                        <tr class="animate-fade-in"
                                            style="animation-delay: @(Model.ToList().IndexOf(order) * 0.1)s">
                                            <td>
                                                <strong>@order.OrderNumber</strong>
                                                <br>
                                                <small class="text-muted">ID: @order.Id</small>
                                            </td>
                                            <td>
                                                @if (order.Customer != null)
                                                {
                                                    <strong>@order.Customer.Name</strong>
                                                    @if (!string.IsNullOrEmpty(order.Customer.Phone))
                                                    {
                                                        <br>
                                                        <small class="text-muted">@order.Customer.Phone</small>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Customer not found</span>
                                                }
                                            </td>
                                            <td>
                                                @if (order.Supplier != null)
                                                {
                                                    <strong>@order.Supplier.Name</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                @order.OrderDate.ToString("MMM dd, yyyy")
                                                <br>
                                                <small class="text-muted">@order.OrderDate.ToString("hh:mm tt")</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@order.Items?.Count()</span>
                                            </td>

                                            <td style="white-space:nowrap;">
                                                <strong
                                                class="text-success fw-bold">@SIOMS.Helpers.CurrencyFormatter.Format(order.GrandTotal)</strong>
                                            </td>
                                            <td style="white-space:nowrap;">
                                                <span
                                                class="text-success fw-bold">@SIOMS.Helpers.CurrencyFormatter.Format(order.PaidAmount)</span>
                                            </td>
                                            <td style="white-space:nowrap;">
                                                <span
                                                class="text-danger fw-bold">@SIOMS.Helpers.CurrencyFormatter.Format(order.RemainingAmount)</span>
                                            </td>
                                            <td>
                                                @switch (order.Status)
                                                {
                                                    case "Processing":
                                                        <span class="badge bg-info">Processing</span>
                                                        break;
                                                    case "Completed":
                                                        <span class="badge bg-success">Completed</span>
                                                        break;
                                                    case "Cancelled":
                                                        <span class="badge bg-danger">Cancelled</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-secondary">@order.Status</span>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                @{
                                                    var soListBadge = order.PaymentStatus switch
                                                    {
                                                        "Paid" => "bg-success",
                                                        "Partial" => "bg-warning text-dark",
                                                        _ => "bg-danger"
                                                    };
                                                }
                                                <span class="badge @soListBadge">@order.PaymentStatus</span>
                                            </td>
                                            <td style="white-space:nowrap; min-width:120px;">
                                                <div class="btn-group btn-group-sm"
                                                     style="display:flex; flex-wrap:nowrap; gap:4px; align-items:center;">
                                                    <a asp-controller="Order" asp-action="SalesOrderDetails"
                                                       asp-route-id="@order.Id" class="btn btn-outline-info"
                                                       title="View Details"
                                                       style="padding:4px 8px; font-size:0.75rem; min-height:30px; min-width:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:4px;">
                                                        <i class="fas fa-eye" style="font-size:0.75rem;"></i>
                                                    </a>
                                                    @if (order.Status != "Cancelled" && !(order.Status == "Completed" &&
                                            order.PaymentStatus == "Paid"))
                                                    {
                                                        <a asp-controller="Order" asp-action="EditSalesOrder"
                                                           asp-route-id="@order.Id" class="btn btn-outline-primary" title="Edit"
                                                           style="padding:4px 8px; font-size:0.75rem; min-height:30px; min-width:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:4px;">
                                                            <i class="fas fa-edit" style="font-size:0.75rem;"></i>
                                                        </a>
                                                    }
                                                    <a asp-controller="Order" asp-action="DeleteSalesOrder"
                                                       asp-route-id="@order.Id" class="btn btn-outline-danger delete-confirm"
                                                       title="Delete Order"
                                                       data-message="Are you sure you want to delete order '@order.OrderNumber'? This action cannot be undone."
                                                       style="padding:4px 8px; font-size:0.75rem; min-height:30px; min-width:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:4px;">
                                                        <i class="fas fa-trash" style="font-size:0.75rem;"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="11" class="text-center py-5">
                                            <i class="fas fa-shopping-bag fa-3x text-muted mb-3"></i>
                                            <h5 class="text-muted">No sales orders found</h5>
                                            <p class="text-muted mb-4">Get started by creating your first sales order.</p>
                                            <a asp-controller="Order" asp-action="CreateSalesOrder" class="btn btn-primary">
                                                <i class="fas fa-plus me-2"></i> Create First Order
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Date validation: To date must be at least 1 day after From date
            const fromDate = document.getElementById('salesFromDate');
            const toDate = document.getElementById('salesToDate');

            if (fromDate && toDate) {
                function validateDates() {
                    if (fromDate.value && toDate.value) {
                        const from = new Date(fromDate.value);
                        const to = new Date(toDate.value);

                        // Calculate difference in days
                        const diffTime = to - from;
                        const diffDays = diffTime / (1000 * 60 * 60 * 24);

                        if (diffDays < 1) {
                            alert('"To" date must be at least 1 day after "From" date.');
                            toDate.value = '';
                            return false;
                        }
                    }
                    return true;
                }

                // Set initial min/max
                if (fromDate.value) {
                    const from = new Date(fromDate.value);
                    const minDate = new Date(from);
                    minDate.setDate(minDate.getDate() + 1);
                    toDate.min = minDate.toISOString().split('T')[0];
                }
                if (toDate.value) {
                    const to = new Date(toDate.value);
                    const maxDate = new Date(to);
                    maxDate.setDate(maxDate.getDate() - 1);
                    fromDate.max = maxDate.toISOString().split('T')[0];
                }

                fromDate.addEventListener('change', function () {
                    if (this.value) {
                        const from = new Date(this.value);
                        const minDate = new Date(from);
                        minDate.setDate(minDate.getDate() + 1);
                        toDate.min = minDate.toISOString().split('T')[0];

                        // Clear to date if invalid
                        if (toDate.value && toDate.value <= this.value) {
                            alert('"To" date must be at least 1 day after "From" date.');
                            toDate.value = '';
                        }
                    }
                });

                toDate.addEventListener('change', function () {
                    if (this.value && fromDate.value) {
                        const from = new Date(fromDate.value);
                        const to = new Date(this.value);
                        const diffTime = to - from;
                        const diffDays = diffTime / (1000 * 60 * 60 * 24);

                        if (diffDays < 1) {
                            alert('"To" date must be at least 1 day after "From" date.');
                            this.value = '';
                        }
                    }
                });

                // Validate on form submit
                const filterForm = document.getElementById('salesFilterForm');
                if (filterForm) {
                    filterForm.addEventListener('submit', function (e) {
                        if (!validateDates()) {
                            e.preventDefault();
                        }
                    });
                }
            }

            document.querySelectorAll('.delete-confirm').forEach(function (button) {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    var message = this.dataset.message || 'Are you sure you want to delete this item?';
                    if (confirm(message)) {
                        window.location.href = this.href;
                    }
                });
            });

            setTimeout(function () {
                document.querySelectorAll('.alert').forEach(function (alert) {
                    var bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);
        });
    </script>
}