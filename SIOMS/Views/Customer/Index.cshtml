@model IEnumerable<SIOMS.Models.Customer>
@{
    ViewData["Title"] = "Customers";
    ViewData["Subtitle"] = "Manage your customers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <form method="get" asp-controller="Customer" asp-action="Index" class="row g-3">
                        <div class="col-auto">
                            <input type="text" name="search" class="form-control" placeholder="Search customers..."
                                   value="@ViewBag.SearchTerm">
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Search
                            </button>
                            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                            {
                                <a asp-controller="Customer" asp-action="Index" class="btn btn-secondary ms-2">
                                    <i class="fas fa-redo"></i> Reset
                                </a>
                            }
                        </div>
                    </form>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a asp-controller="Customer" asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus"></i> Add New Customer
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>Customer</th>
                                <th>Contact</th>
                                <th>Email</th>
                                <th>City</th>
                                <th>Type</th>
                                <th>Orders</th>
                                <th>Spent</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var customer in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center" style="gap:12px;">
                                            <i class="fas fa-user text-primary"
                                               style="font-size:1rem;width:20px;text-align:center;"></i>
                                            <div>
                                                <strong>@customer.Name</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(customer.Phone))
                                        {
                                            <a href="tel:@customer.Phone" class="text-decoration-none">
                                                @customer.Phone
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(customer.Email))
                                        {
                                            <a href="mailto:@customer.Email" class="text-decoration-none">
                                                @customer.Email
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    
                                    <td>
                                         @if (!string.IsNullOrEmpty(customer.City))
                                                {
                                                    <strong>@customer.City</strong>
                                                }
                                         else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @(customer.CustomerType == "VIP" ? "bg-warning" : customer.CustomerType == "Wholesale" ? "bg-primary" : "bg-secondary")">
                                            @customer.CustomerType
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@(customer.SalesOrders?.Count ?? 0)</span>
                                    </td>
                                    <td>
                                        @{
                                            var totalSpent = customer.SalesOrders?.Where(so => so.Status == "Completed")
                                                .Sum(so => so.GrandTotal) ?? 0;
                                        }
                                        <span class="fw-bold text-success">@SIOMS.Helpers.CurrencyFormatter.Format(totalSpent)</span>
                                    </td>
                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input status-toggle" type="checkbox" 
                                                   data-id="@customer.Id" @(customer.IsActive ? "checked" : "")>
                                            <label class="form-check-label status-label">
                                                @(customer.IsActive ? "Active" : "Inactive")
                                            </label>
                                        </div>
                                    </td>
                                    <td style="white-space:nowrap;">
                                        <div class="btn-group btn-group-sm" style="display:flex; flex-wrap:nowrap; gap:4px; align-items:center;">
                                            <a asp-controller="Customer" asp-action="Details" asp-route-id="@customer.Id"
                                               class="btn btn-outline-info" title="View Details" 
                                               style="padding:4px 8px; font-size:0.75rem; min-height:30px; min-width:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:4px;">
                                                <i class="fas fa-eye" style="font-size:0.75rem;"></i>
                                            </a>
                                            <a asp-controller="Customer" asp-action="Edit" asp-route-id="@customer.Id"
                                               class="btn btn-outline-primary" title="Edit" 
                                               style="padding:4px 8px; font-size:0.75rem; min-height:30px; min-width:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:4px;">
                                                <i class="fas fa-edit" style="font-size:0.75rem;"></i>
                                            </a>
                                            <form asp-controller="Customer" asp-action="Delete" asp-route-id="@customer.Id"
                                                  method="post" class="delete-confirm-form d-inline"
                                                  data-message="Are you sure you want to delete '@customer.Name'? This action cannot be undone.">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger" title="Delete" 
                                                        style="padding:4px 8px; font-size:0.75rem; min-height:30px; min-width:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:4px;">
                                                    <i class="fas fa-trash" style="font-size:0.75rem;"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-user fa-3x text-muted mb-3"></i>
                    <h5 class="text-muted">No customers found</h5>
                    <p class="text-muted mb-4">Get started by adding your first customer.</p>
                    <a asp-controller="Customer" asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i> Add First Customer
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Status toggle
            document.querySelectorAll('.status-toggle').forEach(toggle => {
                toggle.addEventListener('change', function () {
                    const customerId = this.dataset.id;
                    const isActive = this.checked;
                    const label = this.closest('.form-check').querySelector('.status-label');

                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    fetch('@Url.Action("ToggleStatus", "Customer")/' + customerId, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token || ''
                        }
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                if (label) {
                                    label.textContent = data.isActive ? 'Active' : 'Inactive';
                                }
                                showNotification(data.message, 'success');
                            } else {
                                this.checked = !isActive;
                                showNotification(data.message, 'danger');
                            }
                        })
                        .catch(error => {
                            this.checked = !isActive;
                            showNotification('Error updating status', 'danger');
                        });
                });
            });

            // Delete confirmation
            document.querySelectorAll('.delete-confirm-form').forEach(form => {
                form.addEventListener('submit', function(e) {
                    e.preventDefault();
                    var message = this.dataset.message || 'Are you sure you want to delete this item?';
                    if (confirm(message)) {
                        this.submit();
                    }
                });
            });

            // Auto-dismiss alerts
            setTimeout(() => {
                document.querySelectorAll('.alert').forEach(alert => {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 5000);

            // Notification function
            function showNotification(message, type) {
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
                alertDiv.style.zIndex = '9999';
                alertDiv.innerHTML = `
                    <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(alertDiv);

                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.parentNode.removeChild(alertDiv);
                    }
                }, 5000);
            }
        });
    </script>
}