@model SIOMS.ViewModels.AdminForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/admin/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-container">
            <div class="logo-container">
                <div class="logo"><i class="fas fa-key"></i></div>
                <h1 class="app-name">Forgot Password</h1>
                <p class="app-tagline">Enter your admin username or email</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-custom">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @Html.ValidationSummary()
                </div>
            }

            <form method="post" asp-action="ForgotPassword" id="forgotForm">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label asp-for="Identifier" class="form-label fw-semibold">Username or Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-user text-muted"></i></span>
                        <input asp-for="Identifier" class="form-control" placeholder="Enter username or email" required autofocus />
                    </div>
                    <span asp-validation-for="Identifier" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-login" id="sendBtn">
                    <i class="fas fa-paper-plane me-2"></i>
                    <span id="sendBtnText">Send OTP</span>
                    <span id="sendBtnSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                </button>
            </form>

            <div class="footer-note">
                <a asp-action="Login">Back to Login</a>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('forgotForm').addEventListener('submit', function () {
            const btn = document.getElementById('sendBtn');
            document.getElementById('sendBtnText').textContent = 'Sending...';
            document.getElementById('sendBtnSpinner').classList.remove('d-none');
            btn.disabled = true;
        });
    </script>
</body>
</html>