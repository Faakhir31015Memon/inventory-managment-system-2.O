@model SIOMS.Models.Supplier
@{
    ViewData["Title"] = "Supplier Details";
    ViewData["Subtitle"] = "View supplier information";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section HeaderButtons {
    <a asp-controller="Supplier" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i> Back to List
    </a>
    <a asp-controller="Supplier" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        <i class="fas fa-edit me-2"></i> Edit
    </a>
}

<div class="row">
    <div class="col-lg-10 mx-auto">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-building me-2"></i> Supplier Details
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-3 text-center mb-3 mb-md-0">
                        <div class="display-1 text-info">
                            <i class="fas fa-truck-loading"></i>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <h2 class="mb-2">@Model.Name</h2>
                        <p class="text-muted mb-3">Supplier ID: @Model.Id</p>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted mb-2">Phone:</h6>
                                @if (!string.IsNullOrEmpty(Model.Phone))
                                {
                                    <p class="mb-0">
                                        <a href="tel:@Model.Phone" class="text-decoration-none">
                                            @Model.Phone
                                        </a>
                                    </p>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Not provided</p>
                                }
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted mb-2">Status:</h6>
                                <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                                    @(Model.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted mb-2">Email:</h6>
                                @if (!string.IsNullOrEmpty(Model.Email))
                                {
                                    <p class="mb-0">
                                        <a href="mailto:@Model.Email" class="text-decoration-none">
                                            @Model.Email
                                        </a>
                                    </p>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Not provided</p>
                                }
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted mb-2">Address:</h6>
                                @if (!string.IsNullOrEmpty(Model.Address))
                                {
                                    <p class="mb-0">@Model.Address</p>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Not provided</p>
                                }
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted mb-2">Created Date:</h6>
                                <p class="mb-0">
                                    <i class="fas fa-calendar-plus me-2"></i>
                                    @Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")
                                </p>
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted mb-2">Total Orders:</h6>
                                <p class="mb-0">
                                    <span class="badge bg-primary">@(Model.PurchaseOrders?.Count ?? 0)</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>