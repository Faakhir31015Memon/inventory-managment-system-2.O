@model SIOMS.ViewModels.AdminVerifyOtpViewModel
@{
    ViewData["Title"] = "Verify OTP";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/admin/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-wrapper">
        <div class="login-container">
            <div class="logo-container">
                <div class="logo"><i class="fas fa-shield-alt"></i></div>
                <h1 class="app-name">Verify OTP</h1>
                <p class="app-tagline">Check your registered email for the code</p>
            </div>

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-custom">
                    <i class="fas fa-info-circle me-2"></i>@TempData["Info"]
                </div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-custom">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @Html.ValidationSummary()
                </div>
            }

            <form method="post" asp-action="VerifyOtp">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label asp-for="Otp" class="form-label fw-semibold">6-Digit OTP</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-hashtag text-muted"></i></span>
                        <input asp-for="Otp" class="form-control" maxlength="6" placeholder="Enter OTP" required autofocus />
                    </div>
                    <span asp-validation-for="Otp" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-login">
                    <i class="fas fa-check-circle me-2"></i>Verify OTP
                </button>
            </form>

            <div class="footer-note">
                <a asp-action="ForgotPassword">Resend OTP</a> | <a asp-action="Login">Back to Login</a>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>