@model IEnumerable<SIOMS.Models.AlertLog>

@{
    ViewData["Title"] = "Alerts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-exclamation-triangle"></i> Alert Management
        </h3>
        <div class="card-tools">
            <div class="btn-group">
                <a asp-controller="Alert" asp-action="Index" asp-route-resolved="false" class="btn btn-sm btn-warning">
                    <i class="fas fa-clock"></i> Active
                </a>
                <a asp-controller="Alert" asp-action="Index" asp-route-resolved="true" class="btn btn-sm btn-success">
                    <i class="fas fa-check"></i> Resolved
                </a>
                <a asp-controller="Alert" asp-action="Index" class="btn btn-sm btn-secondary">
                    <i class="fas fa-list"></i> All
                </a>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-check-circle text-success" style="font-size: 48px;"></i>
                <h4 class="mt-3">No alerts found</h4>
                <p class="text-muted">All systems are operating normally.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Message</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in Model)
                        {
                            <tr class="@(alert.IsResolved ? "table-success" : "table-warning")">
                                <td>
                                    <strong>@alert.Product?.Name</strong>
                                </td>
                                <td>@alert.Message</td>
                                <td>
                                    <span class="badge @(alert.AlertType == "LowStock" ? "badge-warning" : "badge-danger")">
                                        @alert.AlertType
                                    </span>
                                </td>
                                <td>@alert.AlertDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (alert.IsResolved)
                                    {
                                        <span class="badge badge-success">
                                            <i class="fas fa-check"></i> Resolved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">
                                            <i class="fas fa-clock"></i> Active
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        @if (alert.ProductId > 0)
                                        {
                                            <a asp-controller="Order" asp-action="CreatePurchaseOrder"
                                               asp-route-productId="@alert.ProductId"
                                               class="btn btn-outline-primary" title="Create Purchase Order for this product">
                                                <i class="fas fa-shopping-cart"></i>
                                            </a>
                                        }
                                        <a asp-controller="Alert" asp-action="Details" asp-route-id="@alert.Id" 
                                           class="btn btn-outline-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (!alert.IsResolved)
                                        {
                                            <button type="button" class="btn btn-success" 
                                                    data-toggle="modal" 
                                                    data-target="#resolveModal" 
                                                    data-id="@alert.Id"
                                                    data-product="@alert.Product?.Name">
                                                <i class="fas fa-check"></i> Resolve
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>



@section Scripts {
    <script>
        $(document).ready(function() {
            // Resolve Modal
            $('#resolveModal').on('show.bs.modal', function(event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var product = button.data('product');
                var modal = $(this);
                modal.find('#resolveAlertId').val(id);
                modal.find('#resolveProductName').text(product);
            });
           
    </script>
}