@model SIOMS.Models.Purchaser
@{
    ViewData["Title"] = "Delete Purchaser";
    ViewData["Subtitle"] = "Confirm purchaser deletion";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section HeaderButtons {
    <a asp-controller="Purchaser" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i> Back to List
    </a>
}

<div class="row">
    <div class="col-lg-6 mx-auto">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i> Delete Purchaser
                </h5>
            </div>
            <div class="card-body">
                <div class="alert alert-danger">
                    <h5 class="alert-heading">Warning!</h5>
                    <p>You are about to delete the purchaser <strong>"@Model.Name"</strong>. This action cannot be undone.</p>
                </div>
                
                <div class="purchaser-info mb-4">
                    <h6 class="text-muted mb-3">Purchaser Details</h6>
                    <div class="row">
                        <div class="col-12 mb-3">
                            <strong>Name:</strong>
                            <p class="mb-0">@Model.Name</p>
                        </div>
                        
                        <div class="col-12 mb-3">
                            <strong>Contact:</strong>
                            <p class="mb-0">@Model.Phone</p>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <div class="col-12 mb-3">
                                <strong>Email:</strong>
                                <p class="mb-0">@Model.Email</p>
                            </div>
                        }
                        
                        <div class="col-12 mb-3">
                            <strong>Total Orders:</strong>
                            <p class="mb-0">
                                <span class="badge @((Model.PurchaseOrders?.Count ?? 0) > 0 ? "bg-danger" : "bg-success")">
                                    @(Model.PurchaseOrders?.Count ?? 0) orders
                                </span>
                            </p>
                        </div>
                    </div>
                </div>
                
                @if (Model.PurchaseOrders?.Any() == true)
                {
                    <div class="alert alert-warning">
                        <h6 class="alert-heading"><i class="fas fa-exclamation-circle me-2"></i> Important Notice</h6>
                        <p class="mb-0">
                            This purchaser has <strong>@Model.PurchaseOrders.Count purchase orders</strong>. 
                            You must remove or reassign all orders before deleting.
                        </p>
                    </div>
                }
                
                <form method="post" asp-controller="Purchaser" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="d-flex justify-content-between">
                        <a asp-controller="Purchaser" asp-action="Index" class="btn btn-secondary">Cancel</a>
                        
                        @if (Model.PurchaseOrders?.Any() == true)
                        {
                            <button type="button" class="btn btn-danger" disabled>
                                <i class="fas fa-trash me-2"></i> Delete Purchaser
                            </button>
                            <small class="text-muted d-block mt-2">Delete button is disabled. Remove all related records first.</small>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-danger" id="deleteBtn">
                                <i class="fas fa-trash me-2"></i> Delete Purchaser
                            </button>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const deleteBtn = document.getElementById('deleteBtn');
            
            if (deleteBtn) {
                deleteBtn.addEventListener('click', function(e) {
                    if (!confirm('Are you sure you want to delete this purchaser?')) {
                        e.preventDefault();
                    } else {
                        this.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Deleting...';
                        this.disabled = true;
                    }
                });
            }
        });
    </script>
}