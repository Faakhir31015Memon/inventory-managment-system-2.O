@model IEnumerable<SIOMS.Models.Product>
@{
    ViewData["Title"] = "Products";
    ViewData["Subtitle"] = "Manage your inventory products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="row align-items-center g-2">
                <div class="col">
                    <form method="get" asp-controller="Product" asp-action="Index" class="row g-2 align-items-center">
                        <div class="col-auto">
                            <input type="text" name="search" class="form-control" placeholder="Search products..."
                                   value="@ViewBag.SearchFilter">
                        </div>
                        <div class="col-auto">
                            <select name="categoryId" class="form-select">
                                <option value="">All Categories</option>
                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Id"
                                            selected="@(ViewBag.CategoryFilter?.ToString() == category.Id.ToString())">
                                        @category.Name
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-search"></i> Search
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(ViewBag.SearchFilter as string) || ViewBag.CategoryFilter != null)
                        {
                            <div class="col-auto">
                                <a asp-controller="Product" asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-redo"></i> Reset
                                </a>
                            </div>
                        }
                    </form>
                </div>
                <div class="col-auto">
                    <a asp-controller="Product" asp-action="Create" class="btn btn-success">
                        <i class="fas fa-plus me-2"></i> Add New Product
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th>Sell Price</th>
                                <th>Purchase Price</th>
                                <th>Stock</th>
                                <th>Min Stock</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model)
                            {
                                <tr class="@(product.StockQuantity <= product.MinStockLimit ? "table-warning" : "")">
                                    <td>
                                        <div class="d-flex align-items-center" style="gap:12px;">
                                            <div class="product-image-circle"
                                                 style="width:40px;height:40px;border-radius:50%;overflow:hidden;flex-shrink:0;background:#f0f0f0;display:flex;align-items:center;justify-content:center;">
                                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                                {
                                                    <img src="@product.ImageUrl" alt="@product.Name"
                                                         style="width:100%;height:100%;object-fit:cover;">
                                                }
                                                else
                                                {
                                                    <i class="fas fa-box" style="color:#999;"></i>
                                                }
                                            </div>
                                            <div>
                                                <strong>@product.Name</strong>
                                                @if (!string.IsNullOrEmpty(product.SKU))
                                                {
                                                    <br>
                                                    <small class="text-muted">SKU: @product.SKU</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (product.Category != null)
                                        {
                                            <span class="badge bg-info">@product.Category.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No category</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@SIOMS.Helpers.CurrencyFormatter.Symbol@(((Dictionary<int,
                                                                                decimal>)ViewBag.ConvertedPrices)[product.Id].ToString("N2"))</strong>
                                            @if (product.OriginalCurrency != (string)ViewBag.DisplayCurrency)
                                            {
                                                <br><small class="text-muted">(@product.Price.ToString("N2")
                                                @product.OriginalCurrency)</small>
                                            }
                                        </td>
                                        <td>
                                            <span class="text-muted">@SIOMS.Helpers.CurrencyFormatter.Symbol@(((Dictionary<int,
                                                                                    decimal>)ViewBag.ConvertedCostPrices)[product.Id].ToString("N2"))</span>
                                            </td>
                                            <td>
                                                <span
                                                    class="badge @(product.StockQuantity <= product.MinStockLimit ? "bg-warning" : "bg-success")">
                                                    @product.StockQuantity
                                                </span>
                                            </td>
                                            <td>@product.MinStockLimit</td>
                                            <td>
                                                @if (product.StockQuantity == 0)
                                                {
                                                    <span class="badge bg-danger">Out of Stock</span>
                                                }
                                                else if (product.StockQuantity <= product.MinStockLimit)
                                                {
                                                    <span class="badge bg-warning">Low Stock</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">In Stock</span>
                                                }

                                                @if (!product.IsActive)
                                                {
                                                    <span class="badge bg-secondary ms-1">Inactive</span>
                                                }
                                            </td>
                                            <!-- ✅ Actions - Inline CSS for 1 line -->
                                            <td style="white-space:nowrap; min-width:120px;">
                                                <div class="btn-group btn-group-sm"
                                                     style="display:flex; flex-wrap:nowrap; gap:4px; align-items:center;">
                                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                                                       class="btn btn-outline-info" title="View Details"
                                                       style="padding:4px 8px; font-size:0.75rem; min-height:30px; min-width:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:4px;">
                                                        <i class="fas fa-eye" style="font-size:0.75rem;"></i>
                                                    </a>
                                                    <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id"
                                                       class="btn btn-outline-primary" title="Edit"
                                                       style="padding:4px 8px; font-size:0.75rem; min-height:30px; min-width:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:4px;">
                                                        <i class="fas fa-edit" style="font-size:0.75rem;"></i>
                                                    </a>
                                                    @{
                                                        var isLocked = ViewBag.LockedProductIds != null &&
                                            ((System.Collections.Generic.HashSet<int>)ViewBag.LockedProductIds).Contains(product.Id);
                                                    }
                                                    @if (isLocked)
                                                    {
                                                        <button type="button" class="btn btn-outline-secondary" disabled
                                                                title="Cannot delete - this product is part of a completed order"
                                                                style="padding:4px 8px; font-size:0.75rem; min-height:30px; min-width:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:4px;">
                                                            <i class="fas fa-lock" style="font-size:0.75rem;"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <a asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id"
                                                           class="btn btn-outline-danger delete-confirm" title="Delete"
                                                           data-message="Are you sure you want to delete '@product.Name'? This action cannot be undone."
                                                           style="padding:4px 8px; font-size:0.75rem; min-height:30px; min-width:30px; display:inline-flex; align-items:center; justify-content:center; border-radius:4px;">
                                                            <i class="fas fa-trash" style="font-size:0.75rem;"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
            else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-boxes fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No products found</h5>
                            <p class="text-muted mb-4">Get started by adding your first product.</p>
                            <a asp-controller="Product" asp-action="Create" class="btn btn-primary">
                                <i class="fas fa-plus me-2"></i> Add First Product
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        @section Scripts {
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    document.querySelectorAll('.delete-confirm').forEach(function (button) {
                        button.addEventListener('click', function (e) {
                            e.preventDefault();
                            var message = this.dataset.message || 'Are you sure you want to delete this item?';
                            if (confirm(message)) {
                                window.location.href = this.href;
                            }
                        });
                    });

                    setTimeout(function () {
                        document.querySelectorAll('.alert').forEach(function (alert) {
                            var bsAlert = new bootstrap.Alert(alert);
                            bsAlert.close();
                        });
                    }, 5000);
                });
            </script>
        }